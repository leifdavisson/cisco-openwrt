# Merge into the board kernel configuration, then rebuild kernel AND modules.
CONFIG_PHYS_64BIT=y
CONFIG_OF_RESERVED_MEM=y
CONFIG_FSL_DPAA=y
CONFIG_P1023_FMAN_DPAA=m
# CONFIG_FSL_DPAA_CHECKING is not set
# CONFIG_FSL_BMAN_TEST is not set
# CONFIG_FSL_QMAN_TEST is not set
CONFIG_PAGE_POOL=y
CONFIG_BQL=y
CONFIG_PHYLIB=y
CONFIG_MARVELL_PHY=m
CONFIG_FSL_PQ_MDIO=m
# CONFIG_FSL_FMAN is not set
# CONFIG_FSL_DPAA_ETH is not set
